# Plate configuration — twelve-factor: config comes ENTIRELY from the environment,
# so the same binary runs unchanged on docker-compose, Fly/Cloud Run, or a box.
#
# This file is the TEMPLATE. Copy it to `.env` (git-ignored) and fill in values.
# Never put real secrets in this file — it is committed to a PUBLIC repo.
# Every KEY that exists is documented here with an empty value.

# ─────────────────────────────────────────────────────────────────────────────
# Process
# ─────────────────────────────────────────────────────────────────────────────
# Same binary, two commands: `plate serve` (API) and `plate work` (worker).
# These vars are read by both unless noted.

PLATE_ENV=                       # development | production
PLATE_LOG_LEVEL=                 # debug | info | warn | error   (structured JSON to stdout)
PLATE_HTTP_ADDR=                 # e.g. :8080  — API listen address (serve only)

# ─────────────────────────────────────────────────────────────────────────────
# Datastore — Plate owns its own Postgres (spec Q2)
# ─────────────────────────────────────────────────────────────────────────────
# Co-locate the DB region with the API/worker: grant lookups are in the hot path.
DATABASE_URL=                    # postgres://user:pass@host:5432/plate?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# Storage — R2, both tiers (spec Q5). S3-compatible: point at any S3 to self-host.
# Plate holds these credentials for the DERIVATIVE path only (server-to-server
# pull + rendition write). Delivery returns URLs; Plate is not in the byte path.
# ─────────────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=                     # https://<account>.r2.cloudflarestorage.com
R2_REGION=                       # "auto" for R2
# Default account bucket/prefix are stored per-account in the DB (accounts table),
# NOT here — one deployment serves many accounts. These are the fallback/bootstrap.
R2_DEFAULT_BUCKET=
R2_PUBLIC_BASE=                  # public base URL for R2-served bytes (AV, documents, originals)

# ─────────────────────────────────────────────────────────────────────────────
# Delivery engine — imgproxy for images (spec §2). ONLY_PRESETS enforced there.
# ─────────────────────────────────────────────────────────────────────────────
IMGPROXY_BASE_URL=               # http://imgproxy:8080  (internal) or a public delivery host
IMGPROXY_KEY=                    # hex — imgproxy URL signing key
IMGPROXY_SALT=                   # hex — imgproxy URL signing salt
# Authenticated download base for intent=original (the named escape hatch).
PLATE_DOWNLOAD_BASE=             # e.g. https://plate.example — base for short-lived original download URLs

# ─────────────────────────────────────────────────────────────────────────────
# Auth — three problems, three answers (spec Q3)
# ─────────────────────────────────────────────────────────────────────────────
# A. Service-to-service: scoped JWT. The account is a CLAIM in this token,
#    never a request parameter. Issuance is separable from validation.
PLATE_JWT_ISSUER=                # iss claim expected on incoming tokens
PLATE_JWT_AUDIENCE=              # aud claim expected on incoming tokens
PLATE_JWT_PUBLIC_KEY=            # base64 raw Ed25519 public key — VALIDATES incoming tokens (EdDSA only). Empty = deny-all (process boots, probes work, every token 401s).
# B. Delivery signing (public/signed modes): key used to sign delivery URLs.
PLATE_DELIVERY_SIGNING_KEY=      # secret used for stateless signed delivery URLs
PLATE_SIGNED_URL_TTL=            # e.g. 600s — expiry for `signed` mode
# Granted mode uses DB-backed grant state; its expiry is per-grant (short: minutes).
PLATE_GRANTED_URL_TTL=           # e.g. 300s — short expiry so revocation is effective within one window

# ─────────────────────────────────────────────────────────────────────────────
# Ceilings — configuration, not constants (spec §5.4). Tunable per deployment.
# ─────────────────────────────────────────────────────────────────────────────
PLATE_MAX_IMAGE_OUTPUT_MP=       # 24  — both CDNs 400 above ~25MP (CDN guard)
PLATE_DECODED_BUDGET_MOBILE=     # 25165824  (24 MiB) — decoded RGBA ceiling, mobile
PLATE_DECODED_BUDGET_DESKTOP=    # 100663296 (96 MiB) — decoded RGBA ceiling, desktop
PLATE_LOOP_MAX_DURATION=         # 30s   — grid loop tier: silent, ~640px
PLATE_LOOP_MAX_WIDTH=            # 640
PLATE_DETAIL_MAX_DURATION=       # 720s  (12 min) — lightbox detail tier: with audio, <=1080p
PLATE_DETAIL_MAX_HEIGHT=         # 1080

# ─────────────────────────────────────────────────────────────────────────────
# Upload broker (spec §5.1) — presigned PUT, browser writes direct to R2.
# ─────────────────────────────────────────────────────────────────────────────
PLATE_UPLOAD_URL_TTL=            # 3600s — generous for a studio's slow connection (learned the hard way)
PLATE_UPLOAD_MAX_BYTES=          # content-length ceiling bound into the presigned PUT

# ─────────────────────────────────────────────────────────────────────────────
# Worker (spec Q4) — `plate work`. Region: use a TIER 1 Cloud Run region.
# ─────────────────────────────────────────────────────────────────────────────
PLATE_WORKER_CONCURRENCY=        # how many transcode jobs one worker runs at once
PLATE_WORKER_SCRATCH_DIR=        # e.g. /scratch — real disk for ffmpeg, NOT tmpfs
PLATE_FFMPEG_PATH=               # ffmpeg  (path or bare name on PATH)
PLATE_FFPROBE_PATH=              # ffprobe
