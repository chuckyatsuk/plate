# --- Secrets (this repo is public; a leaked key in history is compromised) ---
# Ignore every env file EXCEPT the committed, value-less template.
.env
.env.*
!.env.example

# Credentials that occasionally land in a working tree
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*-key.json

# --- Go ---
# Binaries
/plate
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binaries and coverage
*.test
*.out
coverage.txt
coverage.html
# Go workspace
go.work
go.work.sum

# --- Local dev / tooling ---
# Ephemeral transcode scratch, downloaded originals, generated renditions
/tmp/
/scratch/
/testdata/fixtures/generated/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Docker / compose local overrides
docker-compose.override.yml

# --- Notes to chuck (not part of the public artifact) ---
.scratch/
